<?xml version="1.0" encoding="utf-8"?>
<!--
  PoliMusic - Configuracion de IIS para la aplicacion.
  Se mantiene al minimo a proposito: los ajustes que requieren permisos de
  administrador (ASP clasico, tamano maximo de peticion y errores detallados)
  se aplican con el script Deploy\instalar_iis.ps1.
-->
<configuration>
  <system.webServer>

    <defaultDocument>
      <files>
        <clear />
        <add value="default.asp" />
      </files>
    </defaultDocument>

  </system.webServer>
</configuration>
